## Project-specific

# WorkBuddy internal state (memory, skills, agents)
.workbuddy/

# Agent / hook runtime state (finding-ledger, run history, hook-state,
# reports) — generated at runtime, must NOT be tracked (same class as .workbuddy/)
.mimosa/

# Runtime-generated encryption keystore (per-environment, sensitive).
# Recreated on first key save; do not commit.
data/keys.enc

# User-created custom question banks (per-subject runtime data, not source)
data/bank_custom.json
data/bank_custom_*.json

# User uploads (runtime content, same class as media/)
uploads/

# SQLite databases (generated at runtime, NOT committed)
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.bak.*
*.bak

# Runtime logs (RotatingFileHandler output)
*.log
*.log.*

# Test-local temp data (workspace-confined)
tests/.tmp/

# B1: uploaded photos (user data, generated at runtime)
media/

# Build dependencies (PyInstaller)
.builddeps/

# Coverage
.coverage
.coverage.*
htmlcov/

# Misc
.cache
.pytest_cache/
.ruff_cache/

# Planning / worklog docs (authored & iterated locally, NOT source — do not track)
LearnOS-综合优化方案.md
OPTIMIZATION_PLAN.md
OPTIMIZATION_PLAN_V2.md
WORK_LOG.md
.git.corrupt-bak.*/
.audit-tmp/
